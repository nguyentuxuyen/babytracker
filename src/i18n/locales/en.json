    "newSkills": "New skills your baby may learn:",
    "leaps": {
      "1": {
        "name": "The World of Changing Sensations",
        "description": "Your baby becomes more sensitive to their senses. They may cry more, want to feed more often and need more cuddles.",
        "skills": [
          "Looks at things longer and more intently.",
          "Reacts more clearly to sounds, smells and tastes.",
          "Gives the first deliberate smile.",
          "Digestion develops; may burp more."
        ]
      },
      "2": {
        "name": "The World of Patterns",
        "description": "Your baby starts to notice rules and patterns in the world around them and gains better control of their body.",
        "skills": [
          "Discovers their own hands and feet.",
          "Makes sounds and listens to them.",
          "Likes looking at high-contrast pictures.",
          "Holds their head more steadily."
        ]
      },
      "3": {
        "name": "The World of Smooth Transitions",
        "description": "Your baby notices subtle changes in sound, movement and feeling, and becomes more lively.",
        "skills": [
          "Moves more smoothly and less jerkily.",
          "Follows objects with their eyes and turns their head.",
          "Makes a wider range of babbling sounds.",
          "Brings hands or objects to the mouth."
        ]
      },
      "4": {
        "name": "The World of Events",
        "description": "A big leap! Your baby understands short sequences of events and starts to learn about cause and effect.",
        "skills": [
          "Grabs, holds and shakes objects on purpose.",
          "Rolls from back to tummy (or the other way).",
          "Responds to their own name.",
          "Starts solid foods (if introduced)."
        ]
      },
      "5": {
        "name": "The World of Relationships",
        "description": "Your baby becomes aware of distance and relationships between objects and people. Stranger anxiety may begin.",
        "skills": [
          "Understands that a parent can leave and come back.",
          "Starts crawling or scooting.",
          "Passes objects from one hand to the other.",
          "Takes an interest in small details of toys."
        ]
      },
      "6": {
        "name": "The World of Categories",
        "description": "Your baby starts sorting things into groups. A dog is a dog, whether it is big or small, fluffy or smooth.",
        "skills": [
          "Imitates actions and sounds.",
          "Shows emotions more clearly (happy, sad, angry).",
          "Points at things they want.",
          "Starts pulling up to stand."
        ]
      },
      "7": {
        "name": "The World of Sequences",
        "description": "Your baby understands that reaching a goal takes a series of actions in the right order.",
        "skills": [
          "Plays stacking and building games.",
          "Understands simple requests like \"give it to mommy\".",
          "Waves bye-bye.",
          "Practises first steps."
        ]
      },
      "8": {
        "name": "The World of Programs",
        "description": "Your baby understands there are different ways to reach the same goal and can choose the right \"program\".",
        "skills": [
          "Starts having tantrums to test limits.",
          "Uses a spoon or fork.",
          "Says more words.",
          "Helps with simple household tasks."
        ]
      },
      "9": {
        "name": "The World of Principles",
        "description": "Your baby starts experimenting with rules and consequences, learns to negotiate and understands \"mine\" and \"mommy's\".",
        "skills": [
          "Plays more complex pretend games.",
          "Recognises and names body parts.",
          "Speaks in short sentences.",
          "Shows independence and wants to do everything alone."
        ]
      },
      "10": {
        "name": "The World of Systems",
        "description": "Your baby realises they are a separate person with their own rules and values, and develops a sense of self.",
        "skills": [
          "Understands and follows family rules.",
          "Develops empathy for others.",
          "Can put on simple clothes alone.",
          "Retells things that happened."
        ]
      }
    }
  },
