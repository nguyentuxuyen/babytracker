rules_version = '2';

// Deploy with: npx firebase-tools deploy --only firestore:rules
// Compare with the rules currently in the Firebase console before the first deploy.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Per-user data: activities, ongoingSleep, milestones, babies/{id}/milestones, settings.
    // `usage` (AI quota) and `pushSubscriptions` are written only by the server (Admin SDK).
    match /users/{uid}/{collection}/{document=**} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid) && !(collection in ['usage', 'pushSubscriptions']);
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);
    }

    // Baby profile and food menu; the document id is the owner's uid.
    match /babies/{uid} {
      allow read, write: if isOwner(uid);
      // Legacy lookup by email (BabyContext), only for a verified email of the caller.
      allow read: if signedIn()
        && request.auth.token.email_verified == true
        && resource.data.mail == request.auth.token.email;
    }

    // Release notes, written by scripts/syncChangelogToFirebase.js (Admin SDK).
    match /app_meta/changelog/{document=**} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
