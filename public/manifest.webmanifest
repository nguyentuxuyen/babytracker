{
  "name": "Baby Tracker App",
  "short_name": "BabyTracker",
  "description": "Track feeding, sleep, diaper, growth and milestones for your baby.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
